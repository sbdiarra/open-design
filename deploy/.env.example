# Local production image built from this checkout by docker compose.
# Use a non-latest tag so Compose does not accidentally reuse an older published image.
OPEN_DESIGN_IMAGE=open-design:local

# Install Kilo CLI in the runtime image so the daemon can discover `kilo` inside
# the container. Set to false only if you provide agent CLIs another way.
INSTALL_KILO_CLI=true

# Host port exposed on 127.0.0.1 by docker compose.
# Keep Compose bound to localhost; use an authenticated reverse proxy, SSH tunnel,
# or VPN before exposing Open Design remotely.
OPEN_DESIGN_PORT=7456

# Comma-separated browser origins allowed to call /api when deployed behind a
# domain, public IP, or reverse proxy, e.g. http://203.0.113.10:7456,https://od.example.com.
OPEN_DESIGN_ALLOWED_ORIGINS=

# Container memory limit. Keep at least 1 GiB when running Kilo in-container:
# lower caps can OOM-kill Kilo's native binary mid-stream while the npm wrapper
# reports exit 0, which looks like a successful but truncated agent response.
OPEN_DESIGN_MEM_LIMIT=1g

# Node.js heap cap inside the runtime container. The Dockerfile overrides the
# build-stage heap separately so platforms like Coolify do not OOM while
# running pnpm install/postinstall.
NODE_OPTIONS=--max-old-space-size=192

# Kilo/OpenCode can write session state, downloaded native helpers, and runtime
# metadata outside Open Design's own data directory depending on how it infers the
# project root. Keep the container writable by default for Kilo parity with the
# non-Docker launch. Set to true only after validating Kilo runs in your setup.
OPEN_DESIGN_READ_ONLY=false
